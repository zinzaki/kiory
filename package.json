{
  "name": "kiory",
  "version": "8.2.0",
  "description": "Soft interface icons on a 24 × 24 grid: SVG, sprite, CSS, JS and React",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/kiory.js",
  "types": "./dist/kiory.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kiory.d.ts",
      "default": "./dist/kiory.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./css": "./dist/kiory.css",
    "./sprite": "./dist/kiory.sprite.svg",
    "./json": "./dist/kiory.json",
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "css",
    "kiory"
  ]
}
